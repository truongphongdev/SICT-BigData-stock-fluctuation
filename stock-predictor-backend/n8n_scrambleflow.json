    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst results = [];\n\n// Duyệt qua toàn bộ 87 items trả về từ node HTTP Request\nfor (const item of $input.all()) {\n    const data = item.json;\n    if (Array.isArray(data) && data.length > 0 && typeof data[0] === 'object' && data[0] !== null && 'StockCode' in data[0]) {\n        \n        for (const record of data) {\n            \n            let formattedDate = null;\n            if (record.TradingDate) {\n                const ms = parseInt(record.TradingDate.replace(/[^0-9]/g, \"\"));\n                const dateObj = new Date(ms);\n                \n                const year = dateObj.getFullYear();\n                const month = String(dateObj.getMonth() + 1).padStart(2, '0');\n                const day = String(dateObj.getDate()).padStart(2, '0');\n                formattedDate = `${year}-${month}-${day}`;\n            }\n            results.push({\n                json: {\n                    time: formattedDate,\n                    symbol: record.StockCode,\n                    open: record.OpenPrice,\n                    high: record.HighestPrice,\n                    low: record.LowestPrice,\n                    close: record.ClosePrice,\n                    volume: record.TotalVol\n                }\n            });\n        }\n    }\n}\n\nreturn results;"
      },
